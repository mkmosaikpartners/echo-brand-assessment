{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echo-snapshot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": false,
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [
    // Wird beim ersten Deploy automatisch angelegt
    { "binding": "RESULTS" }
  ],
  "workflows": [
    { "name": "echo-analysis", "binding": "ECHO_WORKFLOW", "class_name": "EchoWorkflow" }
  ],
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "REVIEW_MODE": "on",
    "RATE_LIMIT_PER_HOUR": "5",
    "PUBLIC_URL": "https://echo.mosaik.partners",
    "MAIL_FROM": "Mosaik & Partners <echo@mosaik.partners>",
    "MAIL_REPLY_TO": "mk@mosaik.partners",
    "SMTP_USER": "mk@mosaik.partners",
    "NOTIFY_EMAIL": "mk@mosaik.partners"
  },
  "observability": { "enabled": true }
}
